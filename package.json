{
  "name": "actmind-pool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "行知被试库 (ActMind Pool) — Vue 演示前端与 NestJS / PostgreSQL 本机后端",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:install": "npm ci --prefix server",
    "api:build": "npm run build --prefix server",
    "api:test": "npm test --prefix server",
    "test:ui": "node --test test/*.test.js",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "dev:full": "npm run api:build && node scripts/dev.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.7.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.3.3"
  }
}
