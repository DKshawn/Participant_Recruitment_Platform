NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://actmind:local-development-only@127.0.0.1:55432/actmind
FRONTEND_URL=http://localhost:5173/Participant_Recruitment_Platform/
PUBLIC_API_URL=http://localhost:5173/api
# Explicitly local-only. Production refuses to start if this is true.
ALLOW_DEV_AUTH=true
COOKIE_SECURE=false
# Server-side web application credentials. Never use VITE_ for secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# A specific organization tenant UUID, not common/organizations.
MICROSOFT_TENANT_ID=
# Optional school-only entrance; must match the Microsoft tenant above.
SCHOOL_TENANT_ID=
SCHOOL_EMAIL_DOMAINS=tus.ac.jp,ed.tus.ac.jp
